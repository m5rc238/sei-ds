{
  "name": "sei-ds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sei Design System — built to make the consequences of design decisions visible in real interfaces.",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build-storybook",
    "verify": "node scripts/verify.mjs",
    "chromatic": "npm run build-storybook && npx chromatic"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.2"
  }
}